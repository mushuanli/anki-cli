{
  "updatedAt": 0,
  "defaultConnection": "text",
  "runPolicy": {
    "maxNodes": 128,
    "maxConcurrency": 4
  },
  "id": "anki-generate",
  "name": "Anki 从文本制卡",
  "draftVersion": 2,
  "parameters": [
    {
      "name": "words",
      "label": "单词列表或 WordData JSON",
      "type": "string",
      "required": true,
      "nonBlank": true,
      "onMissing": "interact",
      "widget": "textarea",
      "description": "每行一个英文单词或词组，可用 Unit 2 分组；或粘贴 WordData JSON 数组。每次最多 20 张卡片。"
    },
    {
      "name": "requirements",
      "label": "学习要求",
      "type": "string",
      "default": "面向中国青少年英语学习者，例句简洁自然，中文解释清楚，难度适中。",
      "widget": "textarea",
      "description": "年级、例句难度和记忆技巧偏好。图片及语音默认关闭，可按需开启；需要宿主安装 anki-cli 工具模块。"
    },
    {
      "name": "deckName",
      "label": "牌组名称",
      "type": "string",
      "required": true,
      "nonBlank": true,
      "default": "英语单词"
    },
    {
      "name": "outputDirectory",
      "label": "输出目录",
      "type": "string",
      "required": true,
      "nonBlank": true,
      "default": "anki-output",
      "description": "授权工作区内的相对目录；每次打包保存到独立子目录，保留此前产物。"
    },
    {
      "name": "generateImages",
      "label": "生成配图",
      "type": "boolean",
      "default": false,
      "widget": "checkbox"
    },
    {
      "name": "generateAudio",
      "label": "生成单词和例句语音",
      "type": "boolean",
      "default": false,
      "widget": "checkbox"
    },
    {
      "name": "voice",
      "label": "语音音色",
      "type": "string",
      "default": "",
      "description": "填写所选语音模型支持的音色。"
    }
  ],
  "connections": [
    {
      "name": "text",
      "required": true,
      "tier": "standard",
      "requirements": {
        "operation": "chat",
        "inputModalities": [
          "text"
        ],
        "outputModalities": [
          "text"
        ]
      },
      "description": "生成单词卡片文本的模型连接"
    },
    {
      "name": "image",
      "required": false,
      "tier": "optimal",
      "requirements": {
        "operation": "image.generate",
        "inputModalities": [
          "text"
        ],
        "outputModalities": [
          "image"
        ]
      },
      "description": "配图模型连接（启用配图时绑定）"
    },
    {
      "name": "speech",
      "required": false,
      "tier": "optimal",
      "requirements": {
        "operation": "speech.synthesize",
        "inputModalities": [
          "text"
        ],
        "outputModalities": [
          "audio"
        ]
      },
      "description": "语音模型连接（启用语音时绑定）"
    }
  ],
  "nodes": [
    {
      "id": "collect",
      "name": "填写单词与学习要求",
      "plugin": "builtin.input",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "prompt": "请填写英文单词列表（支持 Unit N 分组）或 WordData JSON 数组。",
        "param": {
          "words": {
            "type": "string",
            "label": "单词列表或 WordData JSON",
            "nonBlank": true,
            "widget": "textarea"
          },
          "requirements": {
            "type": "string",
            "label": "学习要求",
            "default": "面向中国青少年英语学习者，例句简洁自然，中文解释清楚，难度适中。",
            "widget": "textarea"
          }
        }
      },
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      }
    },
    {
      "id": "prepare",
      "name": "校验单词输入与工具环境",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "capabilities": [
        "anki.prepare"
      ],
      "config": {
        "toolId": "anki.prepare",
        "toolVersion": "1",
        "approval": "none",
        "args": {
          "source": "${param.words}"
        }
      },
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      }
    },
    {
      "id": "build",
      "name": "调用公共制卡与打包",
      "plugin": "builtin.flow",
      "pluginVersion": "2.0.0",
      "inputs": {},
      "config": {
        "flowId": "anki-build",
        "parameters": {
          "cards": "${nodes.prepare.outputs.result.cards}",
          "requirements": "${param.requirements}",
          "deckName": "${param.deckName}",
          "outputDirectory": "${param.outputDirectory}",
          "generateImages": "${param.generateImages}",
          "generateAudio": "${param.generateAudio}",
          "voice": "${param.voice}"
        },
        "connectionBindings": {
          "text": "text",
          "image": "image",
          "speech": "speech"
        }
      },
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      }
    }
  ],
  "edges": [
    {
      "id": "collect-prepare",
      "from": "collect",
      "to": "prepare",
      "kind": "control"
    },
    {
      "id": "prepare-build",
      "from": "prepare",
      "to": "build",
      "kind": "control"
    }
  ],
  "outputs": {
    "manifest": {
      "value": "${nodes.build.outputs.manifest}",
      "schema": {
        "type": "object",
        "required": [
          "path",
          "mimeType"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "package": {
      "value": "${nodes.build.outputs.package}",
      "schema": {
        "type": "object",
        "required": [
          "path",
          "mimeType"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "layout": {
    "nodes": {
      "collect": {
        "x": 0,
        "y": 100
      },
      "prepare": {
        "x": 320,
        "y": 100
      },
      "build": {
        "x": 640,
        "y": 100
      }
    },
    "viewport": {
      "x": 0,
      "y": 0,
      "zoom": 1
    }
  }
}
